# Applied only to future automatic dispatches; each assignment retains its deadline.
DRIVER_RESPONSE_WINDOW_MINUTES=120

# Test mode only. Keep the secret key on the backend; the public key is not needed for hosted checkout.
PAYMONGO_TEST_SECRET_KEY=""
PAYMONGO_TEST_WEBHOOK_SECRET=""
PAYMONGO_TEST_SUCCESS_URL=""
PAYMONGO_TEST_CANCEL_URL=""
PAYMONGO_TEST_PAYMENT_METHODS="card,gcash,paymaya"

