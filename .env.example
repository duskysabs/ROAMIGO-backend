# Supabase PostgreSQL connection used by the running NestJS application
DATABASE_URL=""

# Supabase direct/session connection used by Prisma migrations
DIRECT_URL=""

SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Applied only to future automatic dispatches; each assignment retains its deadline.
DRIVER_RESPONSE_WINDOW_MINUTES=120

# Optional server-only location/routing adapter. No credentials belong in this file.
GEOAPIFY_ENABLED=false
GEOAPIFY_API_KEY=""
GEOAPIFY_TIMEOUT_MS=8000

